# =============================================
# Healthcare DApp - Environment Variables
# =============================================
# Copy this file to .env and fill in your values

# ---- Blockchain ----
# Get a free API key from https://www.alchemy.com/
ALCHEMY_API_KEY=your_alchemy_api_key_here

# Your deployer wallet private key (WITHOUT 0x prefix)
# WARNING: Never commit your real private key!
PRIVATE_KEY=your_wallet_private_key_here

# ---- IPFS (Pinata) ----
# Get a free JWT from https://app.pinata.cloud/
PINATA_JWT=your_pinata_jwt_here
PINATA_GATEWAY=your_gateway.mypinata.cloud

# ---- Gas Reporter (Optional) ----
# Get a free API key from https://coinmarketcap.com/api/
COINMARKETCAP_API_KEY=your_coinmarketcap_api_key_here

# ---- Deployed Contract Addresses ----
# These are filled in AFTER deployment
NEXT_PUBLIC_ROLE_MANAGER_ADDRESS=
NEXT_PUBLIC_MEDICAL_RECORD_ADDRESS=
NEXT_PUBLIC_AUDIT_LOGGER_ADDRESS=

# ---- Server ----
PORT=3001
